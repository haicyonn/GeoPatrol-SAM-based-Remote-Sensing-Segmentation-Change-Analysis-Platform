# Replace server_name/certificate paths with the lab's real settings.
# Java stays on loopback; only this HTTPS entry is shared.
server {
    listen 443 ssl;
    server_name xunbian.lab.example;
    ssl_certificate     /etc/nginx/certs/xunbian.crt;
    ssl_certificate_key /etc/nginx/certs/xunbian.key;
    client_max_body_size 300m;
    location / {
        proxy_pass http://127.0.0.1:8786;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 240s;
        proxy_send_timeout 300s;
    }
}
